# 이 파일을 복사해 이름을 정확히 .env 로 바꾸고 값을 채움(.env.txt 가 되지 않게 주의)
# .env 는 .gitignore 에 있어 깃허브에 올라가지 않음. 배포한 앱에는 Streamlit Secrets에 같은 이름으로 넣음
OPENROUTER_API_KEY=""
DATABASE_URL=""
ADMIN_PASSWORD=""

# 선택: 1차,2차,3차 모델을 바꿀 때만 씀(쉼표로 구분). 비워 두면 코드의 기본 모델 3개를 씀
# OPENROUTER_MODELS="nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-120b:free,google/gemma-4-31b-it:free"
